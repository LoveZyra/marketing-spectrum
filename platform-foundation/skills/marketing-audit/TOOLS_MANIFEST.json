{
  "$schema": "./schemas/tools_manifest.schema.json",
  "version": "3.0",
  "description": "宿主 Agent 路由用工具清单（V3 用户-活动粒度，诊断基于 42 条规则 + 6 维统计 + 算法模型）。",
  "phases": [
    "discover_data",
    "describe_data",
    "compute_thresholds",
    "model_required",
    "domain_analysis",
    "diagnostic_rules",
    "synthesize",
    "score_and_render"
  ],
  "tools": [
    {
      "id": "data_fallback",
      "phase": "discover_data",
      "purpose": "扫描 df 缺失字段，按 methodology/06 的回退规则补齐或派生代理列",
      "module": "marketing_audit_skill.snippets.data_fallback",
      "callable": "ensure_required_fields",
      "preconditions": {"df": "required"},
      "postconditions": {"writes": ["state.data_caveats", "df.<derived_columns>"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "data_overview",
      "phase": "describe_data",
      "purpose": "生成 12 维全量描述统计（V2 字段体系，含 CVR 汇总和特征覆盖率）",
      "module": "marketing_audit_skill.snippets.data_overview",
      "callable": "compute_data_overview",
      "preconditions": {"df": "required"},
      "postconditions": {"writes": ["state.data_overview"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "compute_thresholds",
      "phase": "compute_thresholds",
      "purpose": "数据驱动阈值：最优切分点在 is_converted（创单率，信号更密）上找，规则 CVR 对比/有效信号/严重度/卡片展示统一用 is_paid（成单率）；创单率作 create_* 过程指标。评估全部 42 条诊断规则",
      "cli": "python -m marketing_audit_skill.cli compute-thresholds --data <df> --state <state_partial.json> --out <out_dir>",
      "module": "marketing_audit_skill.snippets.threshold_computer",
      "callable": "compute_adaptive_thresholds",
      "methodology": "methodology/09_adaptive_thresholds.md",
      "preconditions": {"state.data_overview_done": true, "is_converted_exists": true},
      "postconditions": {
        "writes": [
          "state.adaptive_thresholds",
          "state.data_overview.diagnostic_rules_summary",
          "<out_dir>/thresholds_report.md"
        ]
      },
      "must_run": true,
      "cost": "low",
      "note": "必须在 domain_analysis 和 diagnostic_rules 之前运行"
    },
    {
      "id": "model_analysis",
      "phase": "model_required",
      "purpose": "训练 LightGBM/XGBoost 二分类，输出 AUC + Top features + decision rules + high_score_not_converted；以 is_paid（最终支付成单）为目标",
      "module": "marketing_audit_skill.snippets.model_analyst",
      "callable": "run_model_analysis",
      "methodology": "methodology/02_model_analysis.md",
      "preconditions": {
        "is_paid_exists": true,
        "is_paid_nunique_ge": 2,
        "n_rows_ge": 100,
        "lib_available_any_of": ["lightgbm", "xgboost"]
      },
      "on_precondition_fail": "在 data_caveats 标注 model 缺席；若运行内部 confidence，model_quality 自动降权为 0.0",
      "postconditions": {"writes": ["state.model_analysis"]},
      "must_run": true,
      "cost": "mid"
    },
    {
      "id": "model_interpreter",
      "phase": "model_required",
      "purpose": "把 model_analysis 的 10 个高/中价值字段机械化抽取为候选 finding/segment/caveat",
      "module": "marketing_audit_skill.snippets.model_interpreter",
      "callable": "interpret_model",
      "methodology": "methodology/02_model_analysis.md",
      "preconditions": {"state.model_analysis_not_null": true},
      "postconditions": {"writes": ["state.findings (auto)", "state.audience_segments (auto)", "state.data_caveats (auto)"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "domain_funnel_diagnosis",
      "phase": "domain_analysis",
      "purpose": "触达前漏斗深度分布、各阶段到达率、倒退分析、决策周期（提供统计上下文，非规则诊断）",
      "module": "marketing_audit_skill.snippets.funnel",
      "callable": "analyze_funnel",
      "preconditions": {"fields_any_of": ["pre_max_funnel_depth", "pre_reached_detail", "pre_mainflow_event_cnt"]},
      "postconditions": {"writes": ["state.agent_raw_stats.funnel_diagnosis", "state.agent_structured_stats.funnel_diagnosis"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "domain_marketing_attribution",
      "phase": "domain_analysis",
      "purpose": "历史渠道触达统计、当次活动渠道 CVR 对比、触达频次-CVR 曲线（提供统计上下文）",
      "module": "marketing_audit_skill.snippets.attribution",
      "callable": "analyze_attribution",
      "preconditions": {"fields_any_of": ["pre_push_touch_cnt", "pre_popup_touch_cnt", "activity_channel_std", "pre_mkt_touch_cnt"]},
      "postconditions": {"writes": ["state.agent_raw_stats.marketing_attribution"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "domain_user_segment",
      "phase": "domain_analysis",
      "purpose": "品类偏好分布、品类匹配度（pre_mkt_product_browse_match）、跨品类浏览（提供统计上下文）",
      "module": "marketing_audit_skill.snippets.user_segment",
      "callable": "analyze_user_segment",
      "preconditions": {"fields_any_of": ["pre_mkt_product_browse_match", "pre_top_interest_product", "pre_is_cross_category"]},
      "postconditions": {"writes": ["state.agent_raw_stats.user_segment"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "domain_price_sensitivity",
      "phase": "domain_analysis",
      "purpose": "优惠/红包敏感度分析、领券 vs 未领券 CVR 对比（提供统计上下文）",
      "module": "marketing_audit_skill.snippets.price_sensitivity",
      "callable": "analyze_price_sensitivity",
      "preconditions": {"fields_any_of": ["pre_coupon_collect_cnt", "pre_rp_target_product"]},
      "postconditions": {"writes": ["state.agent_raw_stats.price_sensitivity"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "domain_platform_behavior",
      "phase": "domain_analysis",
      "purpose": "平台分布 CVR 对比、活跃时段分析、沉默用户识别（提供统计上下文）",
      "module": "marketing_audit_skill.snippets.platform_behavior",
      "callable": "analyze_platform_behavior",
      "preconditions": {"fields_any_of": ["pre_primary_platform", "pre_is_cross_platform", "pre_events_per_hour"]},
      "postconditions": {"writes": ["state.agent_raw_stats.platform_behavior"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "domain_path_quality",
      "phase": "domain_analysis",
      "purpose": "行为路径质量（首末触点、Top10路径 CVR、末次主流程页面分析）",
      "module": "marketing_audit_skill.snippets.path_quality",
      "callable": "analyze_path_quality",
      "preconditions": {"fields_any_of": ["pre_is_marketing_first", "pre_path_model_seq", "pre_last_mainflow_detail"]},
      "postconditions": {"writes": ["state.agent_raw_stats.path_quality"]},
      "must_run": true,
      "cost": "low"
    },
    {
      "id": "diagnostic_rules",
      "phase": "diagnostic_rules",
      "purpose": "评估全部 42 条诊断规则（触发率 + is_converted/is_paid CVR 对比），结果已在 compute_thresholds 阶段写入 state",
      "module": "marketing_audit_skill.snippets.diagnostic_engine",
      "callable": "DiagnosticEngine.rule_summary",
      "methodology": "methodology/08_diagnostic_rules.md",
      "preconditions": {"state.adaptive_thresholds_not_null": true},
      "postconditions": {"reads": ["state.data_overview.diagnostic_rules_summary"]},
      "must_run": true,
      "cost": "low",
      "note": "诊断目标：is_converted / is_paid 的高低。计算结果已在 compute-thresholds 步骤产出，无需重复运行"
    },
    {
      "id": "adhoc_synthesis",
      "phase": "domain_analysis",
      "purpose": "内部复诊/假设补证工具：现有 snippet 无法覆盖时，按 methodology/07 自生成临时分析工具（不作为新版报告展示模块）",
      "module": "marketing_audit_skill.snippets.adhoc_runner",
      "callable": "run_adhoc",
      "methodology": "methodology/07_adhoc_tools.md",
      "preconditions": {"no_existing_tool_matches": true, "hypothesis_open": true},
      "postconditions": {"writes": ["state.adhoc_tools", "state.adhoc_evidences"]},
      "must_run": false,
      "cost": "mid",
      "guards": ["ast_safelist", "30s_timeout", "rows_le_1000"]
    },
    {
      "id": "draft",
      "phase": "synthesize",
      "purpose": "从 compute-thresholds 产物自动装配 state_full 骨架（findings/segments/narratives+typical_case/actions），覆盖全部 effective_signal 主题组并通过完整性校验；宿主 Agent 只需润色 [待润色] 文案并置 _stage=full",
      "cli": "python -m marketing_audit_skill.cli draft --state <state_partial.json> --out <out_dir>",
      "module": "marketing_audit_skill.snippets.draft_builder",
      "callable": "build_draft",
      "methodology": "methodology/03_synthesis.md",
      "preconditions": {"state.diagnostic_rules_summary_not_empty": true},
      "postconditions": {"writes": ["state.findings", "state.audience_segments", "state.narratives", "state.action_plan", "<out_dir>/state_draft.json"]},
      "must_run": false,
      "cost": "low",
      "note": "推荐流程：compute-thresholds → draft → 润色(_stage=full) → self_critique → render"
    },
    {
      "id": "self_critique",
      "phase": "synthesize",
      "purpose": "内部质检工具：对 findings / actions / segments 逐条做合理性裁决，并对不通过项生成复诊计划（不作为新版报告展示模块）",
      "module": "marketing_audit_skill.snippets.self_critique",
      "callable": "assess",
      "methodology": "methodology/05_self_critique.md",
      "preconditions": {"findings_count_ge": 1},
      "loop": "if questioned/pending 非空 → 按 rediagnosis_plan 复诊后再跑，最多 2 次",
      "postconditions": {"writes": ["state.self_critique", "state.self_critique_assessments"]},
      "must_run": false,
      "cost": "low"
    },
    {
      "id": "synthesize_report",
      "phase": "synthesize",
      "purpose": "写 headline / narratives / action_plan（严格遵守 methodology/03 写作禁令）",
      "module": null,
      "callable": "LLM-only",
      "methodology": "methodology/03_synthesis.md",
      "preconditions": {
        "min_problems": 1,
        "all_must_run_domains_done": true,
        "diagnostic_rules_done": true
      },
      "auto_remediation": "核心问题数与 high severity 数由 lint_report_completeness 把关：problems=0 阻断、<3 仅警告；若 high<3，从 diagnostic_rules_summary 提升证据最强的 mid findings（保留真实 severity）",
      "must_run": true,
      "cost": "high"
    },
    {
      "id": "confidence",
      "phase": "score_and_render",
      "purpose": "内部评分工具：4 维度置信度评分（data_coverage / model_quality / finding_richness / evidence_depth），新版 HTML/Markdown 不单独展示",
      "module": "marketing_audit_skill.snippets.confidence",
      "callable": "compute_confidence",
      "methodology": "methodology/04_confidence.md",
      "preconditions": {"findings_count_ge": 1},
      "must_run": false,
      "cost": "low"
    },
    {
      "id": "render",
      "phase": "score_and_render",
      "purpose": "落盘 JSON / Markdown / HTML",
      "module": "marketing_audit_skill.snippets.report_renderer",
      "callable": "save_report",
      "preconditions": {"state._stage_eq": "full"},
      "must_run": true,
      "cost": "low"
    }
  ],
  "router_rules": [
    "1) 启动时先扫描 state 已有 keys 与 df 已有列，缓存为 context",
    "2) must_run=true 且 preconditions 满足的工具 → 按 phase 顺序排入队列",
    "3) compute_thresholds 必须在 domain_analysis 和 diagnostic_rules 之前完成",
    "4) 若工具 preconditions 失败但声明 fallback_if_missing → 调用 data_fallback 后重试",
    "5) 仍失败 → 在 state.data_caveats 写入并标记该维度 skipped；不阻塞流程",
    "6) 所有 domain_* 跑完且 diagnostic_rules 完成 → synthesize_report；若发现结论矛盾/证据不足/用户要求质检 → self_critique",
    "7) self_critique questioned/pending 非空且不接受当前结论 → 按 rediagnosis_plan 复诊；现有工具粒度不足时进入 adhoc_synthesis（见 methodology/07）",
    "8) confidence 可在合成后作为内部评分写入 state，但新版 HTML/Markdown 不展示顶层置信度模块",
    "9) 诊断核心目标只考虑 is_converted 和 is_paid 的高低，不使用点击率等其他指标作为诊断依据",
    "10) 每次工具决策都通过 event_logger.log_decision 落 _decision_trace"
  ]
}
