{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudienceSegment",
  "description": "可直接用于圈人投放的人群包定义。",
  "type": "object",
  "required": ["name", "filter_conditions", "rationale", "action"],
  "properties": {
    "name": {
      "type": "string",
      "description": "人群名称，如\"高意向未转化酒店用户\""
    },
    "filter_conditions": {
      "type": "string",
      "description": "pandas/SQL where 表达式；字段名必须出自 df.columns"
    },
    "rationale": {
      "type": "string",
      "description": "为什么圈这批人"
    },
    "action": {
      "type": "string",
      "description": "对这批人的具体营销动作"
    },
    "estimated_size": {"type": "integer", "minimum": 0},
    "baseline_cvr": {"type": "number", "minimum": 0, "maximum": 1},
    "expected_cvr_low":  {"type": "number", "minimum": 0, "maximum": 1},
    "expected_cvr_mid":  {"type": "number", "minimum": 0, "maximum": 1},
    "expected_cvr_high": {"type": "number", "minimum": 0, "maximum": 1},
    "estimated_incremental_orders": {"type": "integer"},
    "estimated_cost": {"type": "number"},
    "estimated_roi":  {"type": "number"},
    "confidence":     {"type": "number", "minimum": 0, "maximum": 1},
    "direction":      {"type": "string", "enum": ["push", "exclude", "促付"],
                       "description": "人群方向：push=建议推送(正向高转化)、exclude=建议排除(负向低转化)、促付=创单未付需促付。源自关联 finding 的 _signal_type"},
    "finding_id":     {"type": ["string", "null"], "description": "关联的 finding id"}
  }
}
