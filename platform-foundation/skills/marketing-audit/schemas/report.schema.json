{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiagnosisReport",
  "description": "marketing_audit_skill 的最终落盘报告结构。",
  "type": "object",
  "required": ["campaign_id", "findings"],
  "properties": {
    "campaign_id": {"type": "string"},
    "campaign_meta": {"type": "object"},

    "data_overview": {
      "type": "object",
      "description": "12 维全量描述统计，含 diagnostic_rules_summary（来自 compute-thresholds 步骤，记录 42 条规则触发率 + 成单率(is_paid)主口径 CVR 对比 cvr_*、创单率过程口径 create_*、正向展示名 display_name）"
    },

    "adaptive_thresholds": {
      "type": ["object", "null"],
      "description": "由 compute-thresholds 步骤计算的数据驱动阈值。结构：{field_name: {optimal, method, cvr_below, cvr_above, cvr_gap, n_below, n_above, cvr_below_eval, cvr_above_eval, cvr_gap_eval, eval_col, p25..p95}}。最优切分点由创单率(is_converted) Youden's J 决定；cvr_*_eval 为该切分点上的成单率(is_paid)，供卡片展示。"
    },

    "model_analysis": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "backend": {"type": "string"},
            "auc": {"type": "number"},
            "overall_cvr": {"type": "number"},
            "n_samples": {"type": "integer"},
            "n_features": {"type": "integer"},
            "top_features": {"type": "array"},
            "decision_rules": {"type": "array"},
            "score_buckets": {"type": "array"},
            "high_score_not_converted": {"type": "object"},
            "llm_insights": {"type": "string"}
          }
        }
      ]
    },

    "findings": {
      "type": "array",
      "items": {"$ref": "finding.schema.json"}
    },
    "high_severity_count": {"type": "integer"},

    "audience_segments": {
      "type": "array",
      "items": {"$ref": "audience_segment.schema.json"}
    },

    "campaign_adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent":           {"type": "string"},
          "dimension":       {"type": "string"},
          "current_issue":   {"type": "string"},
          "action":          {"type": "string"},
          "expected_impact": {"type": "string"}
        }
      }
    },

    "narratives": {
      "type": ["object", "array"],
      "description": "诊断结论叙述。dict 形态含 headline+problems[]；array 形态是 narratives 列表"
    },

    "action_plan": {
      "type": "object",
      "properties": {
        "cross_validation": {"type": "array"},
        "blind_spots":      {"type": "array"},
        "priority_actions": {
          "type": "array",
          "items": {"$ref": "action.schema.json"}
        },
        "recall_strategy":  {"type": "object", "description": "召回策略（数据层保留，不在 HTML 报告展示）"},
        "data_caveats":     {"type": "array"}
      }
    },

    "data_caveats": {"type": "array", "description": "数据局限性与异常值提示"},
    "blind_spots":  {"type": "array", "description": "内部质检/复诊后保留的待验证盲区；数据层保留，不在 HTML/Markdown 报告中展示"},
    "case_pool":    {"type": "object", "description": "由 cli prepare 的 case_extractor 自动填充；10 种问题模式的代表用户数据，供 LLM 合成 typical_case"},

    "_stage": {
      "type": "string",
      "enum": ["partial", "full"],
      "description": "partial=CLI dry-run 产物，仅含统计层；full=宿主 Agent 已补完 findings/narratives/action_plan"
    },
    "agent_raw_stats": {
      "type": "object",
      "description": "每维度 snippet 输出的字符串摘要。值有两种形态：(a) 单字符串（旧形态），(b) dict[section_name → str]（按 _section 拆分后的形态，避免列错位）。两种都可被 LLM 引证。"
    },
    "agent_structured_stats": {
      "type": "object",
      "description": "可选：每维度 snippet 输出的 records 形式（list[dict]），供宿主 Agent 程序化二次推理"
    },

    "confidence": {
      "type": "object",
      "description": "内部 4 维度置信度评分；新版 HTML/Markdown 不单独展示顶层 confidence 模块",
      "properties": {
        "data_coverage":    {"type": "number", "minimum": 0, "maximum": 1},
        "domain_coverage":  {"type": "number", "minimum": 0, "maximum": 1},
        "rule_coverage":    {"type": "number", "minimum": 0, "maximum": 1},
        "model_quality":    {"type": "number", "minimum": 0, "maximum": 1},
        "finding_richness": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_depth":   {"type": "number", "minimum": 0, "maximum": 1},
        "overall":          {"type": "number", "minimum": 0, "maximum": 1},
        "level":            {"type": "string", "enum": ["高", "中", "低"]}
      }
    }
  }
}
