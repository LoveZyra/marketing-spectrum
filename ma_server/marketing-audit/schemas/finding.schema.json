{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "description": "Step 3 各维度产出的单条发现。",
  "type": "object",
  "required": ["agent", "signal", "severity", "detail"],
  "properties": {
    "id": {
      "type": "string",
      "description": "可选；如宿主 Agent 想做 cross-ref 时用，建议 fnd_<8位hex>"
    },
    "agent": {
      "type": "string",
      "enum": [
        "funnel_diagnosis",
        "domain_funnel_diagnosis",
        "marketing_attribution",
        "domain_marketing_attribution",
        "user_segment",
        "domain_user_segment",
        "price_sensitivity",
        "domain_price_sensitivity",
        "platform_behavior",
        "domain_platform_behavior",
        "path_quality",
        "domain_path_quality",
        "campaign_profile",
        "model_analysis",
        "diagnostic_rules",
        "adhoc",
        "synthesizer"
      ],
      "description": "产出该 finding 的来源 key；diagnostic_rules 是主诊断源（42 条规则），domain 维度（funnel_diagnosis 等）为统计上下文补充，model_analysis 由 model_interpreter 自动产出"
    },
    "rule_id": {
      "type": ["integer", "null"],
      "description": "当 agent=diagnostic_rules 时，关联的规则编号（1-41）"
    },
    "signal": {
      "type": "string",
      "description": "1 句话陈述，必须含具体数值和成单率(is_paid)CVR 对比（参考 methodology/03）"
    },
    "severity": {
      "type": "string",
      "enum": ["high", "mid", "low"]
    },
    "detail": {
      "type": "string",
      "description": "数据依据 + 业务含义（2-3 句）"
    },
    "metric_refs": {
      "type": "array",
      "description": "指标引用，便于追溯。渲染器使用标准键名自动绘制图表，非标准业务键作为补充保留。",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string",
            "description": "渲染器识别的标准键：cvr_triggered | cvr_not_triggered | cvr_gap | trigger_rate | n_event。其他业务键自由命名但不参与图表渲染。"
          },
          "value":   {"type": ["number", "null"]},
          "n_total": {"type": ["integer", "null"], "description": "样本总量（可选）"},
          "n_event": {"type": ["integer", "null"], "description": "触发/事件用户数（可选）"},
          "note":    {"type": ["string", "null"], "description": "可选备注，如 '机票浏览用户 CVR'"},
          "ci_low":  {"type": ["number", "null"]},
          "ci_high": {"type": ["number", "null"]},
          "p_value": {"type": ["number", "null"], "description": "组间差异显著性 p 值；>0.05 时 severity 应降级"}
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "样本量 < 30 时 ≤ 0.6"
    },
    "hypothesis_id": {"type": ["string", "null"]},
    "affected_users": {"type": ["integer", "null"]}
  }
}
