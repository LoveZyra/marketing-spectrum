{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/marketing_audit_skill/schemas/tools_manifest.schema.json",
  "title": "Tools Manifest",
  "description": "TOOLS_MANIFEST.json schema — 宿主 Agent 自主路由用的工具清单",
  "type": "object",
  "required": ["version", "tools", "router_rules"],
  "additionalProperties": true,
  "properties": {
    "$schema":     { "type": "string" },
    "version":     { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "description": { "type": "string" },
    "phases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "执行阶段命名（仅文档用，不参与路由）"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Tool" }
    },
    "router_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Agent 自主路由的规则（自然语言，供 LLM 阅读）"
    }
  },
  "definitions": {
    "Tool": {
      "type": "object",
      "required": ["id", "purpose", "must_run"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "唯一标识符，snake_case"
        },
        "phase":   { "type": "string" },
        "purpose": { "type": "string", "minLength": 5 },
        "module": {
          "type": ["string", "null"],
          "description": "Python 模块路径；LLM-only 工具填 null"
        },
        "callable": {
          "type": "string",
          "description": "可调用名；LLM-only 工具可填 'LLM-only'"
        },
        "methodology": {
          "type": "string",
          "description": "对应方法论文档相对路径，如 methodology/08_diagnostic_rules.md"
        },
        "preconditions": {
          "type": "object",
          "description": "调用前提（Agent 自行校验）",
          "additionalProperties": true
        },
        "postconditions": {
          "type": "object",
          "description": "调用后会写入 state 的哪些字段",
          "additionalProperties": true,
          "properties": {
            "writes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "must_run": {
          "type": "boolean",
          "description": "true 表示在合成报告前必须执行（或显式 skip+caveat）"
        },
        "cost":         { "type": "string", "enum": ["low", "mid", "high"] },
        "skip_action":  { "type": "string" },
        "on_precondition_fail": { "type": "string" },
        "fallback_if_missing": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "derive_from": {},
            "rule":        { "type": "string" }
          }
        },
        "auto_remediation": { "type": "string" },
        "loop":             { "type": "string" },
        "trigger":          { "type": "string" },
        "guards": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
