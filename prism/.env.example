# Prism Environment Configuration
# Copy to `.env` in the project root. Only variables actually read by the code
# are listed here.
#
# TIP: Run 'prism status' to see where this file should be located and to view
#      your current configuration.

# =============================================================================
# SERVER
# =============================================================================

# Backend server port (Express API + WebSocket server).
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# 账号与审批
# ---------------------------------------------------------------------------
# 管理员账号的用户名,逗号分隔可多个,大小写与首尾空格不敏感。
# root 身份每次从这里现算,不写进数据库 —— 换人只改这里重启即可。
# **留空的后果**:没有人是 root,设置页里看不到「账号」标签,
# 新注册的账号永远卡在待审,没人能批。改完必须重启服务才生效。
#
# 这里预置了默认管理员。它只在**注册了同名账号之后**才有意义 ——
# 这个值不会凭空创建账号,你得先用这个用户名注册,该账号才拿到 root。
# 多人写法:PRISM_ROOT_USERS=tianji.chang,alice
PRISM_ROOT_USERS=tianji.chang

# 逃生开关:设 0 关掉整个注册审批闸门,退回改动前的行为(注册即可登录)。
# 建议上线时先设 0 验证一切如常,再注释掉这行打开审批。
# PRISM_APPROVAL_REQUIRED=0

# ---------------------------------------------------------------------------
# 公共项目目录
# ---------------------------------------------------------------------------
# 无主项目(owner_user_id 为空 —— 会话监听器在磁盘上扫到、还没被谁认领的目录)
# 的可见性口径(2026-08-14):
#   · **落在这个目录之下的无主项目 = 公共项目,所有登录用户可见**;
#   · **这个目录之外的无主项目 = 只有 root 看得见**。
# 不配这一项 = 没有任何公共项目,所有无主项目都只有 root 可见。
#
# 存在的理由:以前"无主 = 全公开",于是任何被扫进来、还没认领的目录都自动对
# 全体登录用户可见 —— 一个默认就漏的口子。现在改成"显式圈一块公共地,其余默认
# 私有(仅 root)"。想让团队共享的项目,放到这个目录下即可。
# 必须是绝对路径。改完重启生效。
# PRISM_PUBLIC_WORKSPACE=/workspace/public
# Legacy alias: PORT is honored by the CLI when SERVER_PORT is unset.
# PORT=8080

# Vite dev-server port (development mode with hot-module replacement).
VITE_PORT=5173

# Host/IP to bind the server to.
# Default is 0.0.0.0 (all interfaces) so you can open the UI from other
# devices on your LAN — e.g. a phone or tablet browser.
# HARDENING: on untrusted networks bind to 127.0.0.1 instead (or firewall the
# port / front the server with a reverse proxy + TLS). Anything that can reach
# this port can attempt to log in and, once authenticated, drive an agent with
# filesystem access.
HOST=0.0.0.0

# Allowed CORS origins, comma-separated. Unset keeps the permissive default
# that LAN/mobile browser access relies on. Set it once you know the exact
# origins the UI is served from, e.g. https://prism.example.com
# PRISM_CORS_ORIGINS=

# Set to 1 only when Prism sits behind a reverse proxy you control (nginx,
# Caddy, Traefik). It makes the rate limiters read X-Forwarded-For for the
# client IP. Leave unset on a directly-exposed server: any client could then
# forge that header and give itself a fresh rate-limit bucket per request.
# PRISM_TRUST_PROXY=0

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Secret used to sign auth tokens (JWT). Set a long random string and keep it
# stable — changing it invalidates existing logins. e.g. `openssl rand -hex 32`
# If unset, a per-installation secret is generated and stored in the database.
# JWT_SECRET=

# Optional shared-secret gate in front of ALL /api routes (in addition to the
# normal login/JWT auth). When PRISM_API_KEY is set, every request must carry
# a matching `x-prism-api-key` header; requests without it get 401.
# Set BOTH variables to the same value: the server checks PRISM_API_KEY, and
# the frontend build bakes VITE_PRISM_API_KEY into its requests.
# NOTE: VITE_PRISM_API_KEY is embedded in the served JS bundle — treat this as
# a perimeter speed bump for private deployments, not a client-side secret.
# PRISM_API_KEY=
# VITE_PRISM_API_KEY=

# Websocket upgrades authenticate with a single-use ticket from
# POST /api/auth/ws-ticket, or an Authorization header. Set this to 1 to also
# accept the legacy `?token=<jwt>` query parameter — only worth doing for an
# old client you cannot update, because query strings end up in proxy and
# browser-history logs with the JWT intact.
# PRISM_ALLOW_QUERY_TOKEN=0

# =============================================================================
# RATE LIMITING AND LOGIN LOCKOUT
# =============================================================================
# These are what makes binding to 0.0.0.0 defensible: anything that can reach
# the port gets a bounded number of attempts. Raise the limits rather than
# disabling them if a legitimate client trips one.

# Set to 0 to disable every limiter in the module. Development only.
# PRISM_RATE_LIMIT=1

# Overall /api budget, per IP per window. Default: 600 requests / 60000 ms.
# PRISM_RATE_LIMIT_WINDOW_MS=60000
# PRISM_RATE_LIMIT_MAX=600

# Tighter budget for the auth routes specifically.
# Default: 50 requests / 900000 ms (15 min).
# PRISM_AUTH_RATE_WINDOW_MS=900000
# PRISM_AUTH_RATE_MAX=50

# Per-account lockout after repeated failed logins. Defaults: 5 failures
# within 15 min triggers a 15 min lockout. Repeat lockouts double the
# duration (15 min, 30 min, 1 h, ...), capped at 24 h so an operator locked
# out by someone else's bot can still get back in the same day.
# PRISM_LOGIN_MAX_ATTEMPTS=5
# PRISM_LOGIN_WINDOW_MS=900000
# PRISM_LOGIN_LOCKOUT_MS=900000

# =============================================================================
# SECRETS AT REST
# =============================================================================

# Key for the AES-256-GCM wrapper around stored third-party tokens (GitHub
# PATs, provider keys). Either 64 hex chars (`openssl rand -hex 32`) or a
# passphrase, which gets scrypt-stretched.
# If unset, a key is generated on first use and stored in the database next to
# the data it protects — which defends against someone copying the .db file
# alone, but not against someone who takes the whole data directory. Set this
# explicitly for multi-host setups, and for any backup you might restore onto
# a different machine: without the same key those rows will not decrypt.
# PRISM_ENCRYPTION_KEY=

# Rows kept in the security audit log (login attempts, token issuance,
# permission grants) before the oldest are trimmed. Default: 5000
# PRISM_AUDIT_LOG_MAX_ROWS=5000

# =============================================================================
# CLAUDE (the only provider)
# =============================================================================

# The bundled Claude Agent SDK uses your existing Claude Code CLI login by
# default. Alternatively provide an API key explicitly:
# ANTHROPIC_API_KEY=

# Custom Claude CLI path (default: "claude" on PATH).
# CLAUDE_CLI_PATH=claude

# Claude context window size used for usage display (tokens).
# 注意:只有这一个变量生效(usage.routes.ts / claude-sdk.js 读它)。
# 这里曾经并排放着一行 `VITE_CONTEXT_WINDOW=160000`,全仓无人读 —— 两行长得几乎
# 一样,运维只改其中一个必然踩坑。已删。
CONTEXT_WINDOW=160000

# =============================================================================
# AGENT RUNTIME TUNING (safe defaults if omitted)
# =============================================================================

# Persistent resident SDK sessions (one live runtime per conversation).
# Enabled by default; set to 0 to fall back to one-shot per-turn runs.
# PRISM_PERSISTENT_SESSIONS=1

# Auto-/compact when context usage crosses the high-water mark below.
# Enabled by default; set to 0 to disable.
# PRISM_AUTO_COMPACT=1

# Context usage ratio (0 < r < 1) that triggers auto-compact. Default: 0.8
# PRISM_AUTO_COMPACT_RATIO=0.8

# Max concurrent resident agent runtimes. Default: 20
# PRISM_MAX_RUNTIMES=20          # 全服务器上限,不是每人。一个值 = 一个 Claude 进程

# Idle resident runtime reclaim, in milliseconds. Default: 1800000 (30 min)
# PRISM_RUNTIME_IDLE_MS=1800000

# Extra one-shot fallback slots beyond the resident pool (0 disables overflow).
# Default: 2
# PRISM_MAX_ONESHOT_OVERFLOW=2

# Per-turn watchdog: fail + dispose a runtime whose result never arrives,
# in milliseconds (0 disables). Default: 3600000 (1 hour)
# PRISM_TURN_TIMEOUT_MS=3600000

# =============================================================================
# CHECKPOINTS (per-turn git snapshots with rollback)
# =============================================================================

# Enabled by default for projects that are git repos; set to 0 to disable.
# PRISM_CHECKPOINTS=1

# Where checkpoint refs/snapshots are stored. Default: ~/.prism/checkpoints
# PRISM_CHECKPOINT_DIR=

# Include gitignored files in snapshots. Off by default, because .gitignore in
# a working project usually covers node_modules, build output and .env files —
# snapshotting those is slow and puts secrets in the checkpoint store.
# PRISM_CHECKPOINT_INCLUDE_IGNORED=0

# =============================================================================
# DATA DIRECTORY, DATABASE AND BACKUPS
# =============================================================================

# Where Prism keeps per-user state: auth.db, uploaded assets, markers.
# Default: ~/.prism (migrated once from the older ~/.cloudcli if that exists).
# PRISM_DATA_DIR=

# Path to the authentication/session database file.
# DATABASE_PATH=/path/to/your/custom/auth.db

# Periodic SQLite snapshots of that database. Set to 0 to disable.
# Interval default: 86400000 (24 h); retention default: 7 snapshots.
# PRISM_DB_BACKUP=1
# PRISM_DB_BACKUP_INTERVAL_MS=86400000
# PRISM_DB_BACKUP_KEEP=7

# =============================================================================
# FILE WATCHING AND FILE TREE
# =============================================================================

# Watch session transcripts by polling instead of native filesystem events.
# Needed on NFS/SMB shares and some container bind mounts, where inotify
# delivers no events at all and the watcher would otherwise fail silently.
# Costs CPU proportional to the number of watched files, so leave it off
# unless the session list is visibly not updating.
# PRISM_WATCH_POLL=0
# PRISM_WATCH_POLL_INTERVAL_MS=6000

# Cap on entries returned per file-tree request, to keep a huge repository
# from stalling the sidebar. Default: 5000
# PRISM_FILETREE_MAX_ENTRIES=5000

# =============================================================================
# DOCUMENT AND URL INGESTION
# =============================================================================

# Extracted text kept per document, in characters. Default: 200000
# PRISM_DOC_MAX_CHARS=200000

# Total uncompressed size allowed when expanding a zip (docx/xlsx/pptx are
# zips), in bytes — the guard against zip bombs. Default: 209715200 (200 MB)
# PRISM_DOC_MAX_UNCOMPRESSED=209715200

# Deadline for the sandboxed pdf-parse worker, in ms. Default: 30000
# PRISM_PDF_TIMEOUT_MS=30000

# Deadline for fetching a URL the user pasted, in ms. Default: 20000
# PRISM_URL_FETCH_TIMEOUT_MS=20000

# =============================================================================
# 以 root 运行时的「跳过权限」档位
# =============================================================================
# 症状:聊天里只有 `Claude Code process exited with code 1`,而手动跑
# `claude -p "hi"` 完全正常。真实原因在子进程的 stderr 里:
#
#   --dangerously-skip-permissions cannot be used with root/sudo privileges
#
# claude CLI 里的硬检查是「uid == 0 且 IS_SANDBOX != '1'」,而 Prism 的
# 「跳过权限」执行档位正好翻译成这个参数。**只有这一个档位受影响** ——
# 默认 / 计划 / 接受编辑 / 自动 这四个在 root 下都正常。
#
# 设成 1 就放行。**但要清楚代价**:Prism 是多用户的,这个档位在聊天框的下拉里
# 人人可选,放行等于**每个登录用户都拿到不受限的 root 执行权限,且不再有任何
# 确认框**。更干净的做法是换个非 root 用户跑 Prism,那时这一项完全不需要。
# IS_SANDBOX=1

# --- 服务端强制的工具策略(fd 轮新增,两个都默认不开)---------------------
#
# 上面那段说的问题("这个档位人人可选")在此之前**服务端没有任何手段**:
# 客户端的工具黑白名单存在浏览器 localStorage 里,是用户自己的偏好,随时能清空。
# 下面两个开关是服务端侧的,客户端覆盖不掉。

# 一律禁用的工具,逗号分隔。**无条件并入** disallowedTools,客户端设置顶不掉。
# 多用户部署想禁掉"能跑出去"的工具时用它。
# PRISM_FORCED_DENY_TOOLS=Bash,WebFetch

# 允许使用「跳过权限」(bypassPermissions)的用户名,逗号分隔,大小写不敏感。
# **不配 = 不限制**(维持升级前的行为);配了但为空 = 谁都不许。
# 不在名单里的人发起的回合会从 bypassPermissions **降级**为 acceptEdits ——
# 降级而不是拒绝:拒绝会让一轮对话凭空失败,降级只是把确认框还回来。
# 注意定时任务的默认档位就是 bypassPermissions,配了名单会影响到它们。
# PRISM_ALLOW_BYPASS_USERS=alice,boss

# --- 通知(fd 轮新增)-----------------------------------------------------
#
# 服务端此前**一条通知都发不出去**(Web Push / Electron 两个通道在 web-only 重构时
# 删掉了,编排管线却还完整跑着)。最直接的后果是**定时任务失败没有任何人会知道** ——
# 而无人值守正是定时任务存在的理由。
#
# 配上群机器人地址即可启用(企业微信 / 飞书 / Slack / Discord 都收 POST JSON)。
# 不配就是零通道,编排会早退,一次多余的查询都不会发生。
#
# ⚠️ 地址**只能从这里配,不做成用户可填** —— 用户可填的通知地址是教科书级的 SSRF。
# 即便如此,发送前仍会解析并拒绝内网地址(配错也不该让通知系统变成内网探针)。
# PRISM_NOTIFY_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# --- 日志(fe 轮新增)-----------------------------------------------------
#
# 升级前 `prism.log` 是**一条不分级、不带时间、不带来源的流**,453 处 console.*
# 直接往里写。现在每行都是 `时间 级别 [子系统] 内容`,可以按级别关噪音、
# 按 `[db]` / `[ws-chat]` / `[tasks]` 这样的标签缩小范围。
#
# 档位:silent / error / warn / info / debug / trace,**默认 info**。
# 默认档位下的输出与升级前基本一致 —— 只有逐条挑出来的那批高频行
# (每次浏览目录、每条 WebSocket 连接、git clone 的每块 stderr)被压到了 debug。
# 排障时临时设成 debug 再重启,能把它们全放出来,不用改代码重新部署。
#
# 认不出来的值会退回 info **并在 stderr 上说一声** —— 不会让你以为自己开了详细日志。
# PRISM_LOG_LEVEL=info

# 保留几代旧日志(prism.log.1 … prism.log.N)。默认 5,设成 0 回到"每次启动截断"。
#
# 此前 prism.sh 是 `> prism.log`,**每次启动都把上一轮日志截掉**。而"服务挂了、
# 我重启一下"恰恰是最常见的操作:等你想起来去看它为什么挂,证据已经被自己的
# 重启抹掉了。这个变量只对 `bash prism.sh start` 生效(轮转发生在起服那一刻)。
# PRISM_LOG_KEEP=5

# =============================================================================
# 上传分片(本团队补丁,不是上游行为)
# =============================================================================
# 超过一片的文件会被切片逐个上传、服务端按序追加还原,小于一片的走原路径不变。
# 存在的理由是绕开反向代理的 `client_max_body_size` —— 每一片都小于代理上限,
# 所以即使代理没调大也传得上去。
#
# 两条链路各自独立:`PRISM_LAND_CHUNK_MB` 管聊天附件(/api/documents/land),
# `PRISM_UPLOAD_CHUNK_MB` 管 Files 面板。默认都是 15。
# **新环境先测一下代理的实际上限,低于 15MB 就把这两个调到它之下。**
# PRISM_LAND_CHUNK_MB=15
# PRISM_UPLOAD_CHUNK_MB=15

# =============================================================================
# 营销诊断服务(可选,默认整个不挂载)
# =============================================================================
# 诊断服务是独立的 Python 进程,只听回环;Prism 把 /api/ma/* 反代过去,因为
# 网关只转发 8080。两个变量都不配时 Prism 的行为与没有这个模块时逐字节一致。
#
# 反代目标。不配 = /api/ma/* 整个不挂载。必须是回环地址。
# PRISM_MA_API_TARGET=127.0.0.1:8092
#
# 诊断服务入口的**绝对路径**。配了 Prism 才顺带把它拉起来,并在自己退出时收掉;
# 子进程的监听地址从 PRISM_MA_API_TARGET 反推,所以反代和服务不可能对不上。
# PRISM_MA_API_AUTOSTART=/绝对路径/ma_api_c.py
# PRISM_MA_API_PYTHON=python3
# PRISM_MA_API_ALLOW_NO_KEY=1     # 没有 MA_API_KEY 也允许自启(默认拒绝)

# =============================================================================
# recsys 推荐算法点位监控反代(可选,默认整个不挂载)
# =============================================================================
# 与营销诊断反代同一套安全骨架(只转回环、剥 Prism 凭据),区别是**不做路径
# 白名单** —— 上游是一整个前端页面,路径列不完。所以只往这里挂"整站公开只读"
# 的服务:这层不鉴权,能打到 8080 的人都能看这个页面。
#
# 反代目标。不配 = /recsys/* 整个不挂载。必须是回环地址。
# PRISM_RECSYS_TARGET=127.0.0.1:3010
# PRISM_RECSYS_TIMEOUT_MS=30000      # 上游超时,默认 30000
# PRISM_RECSYS_MAX_BODY=1048576      # 请求体上限字节,默认 1MiB
#
# 上游 recsys 那边要配 HOST=127.0.0.1(别听 0.0.0.0 以外的地址,否则 Prism 从
# 127.0.0.1 连过去是 ECONNREFUSED),以及 PUBLIC_BASE_URL=http://<对外地址>/recsys。

# =============================================================================
# 附件配额与留存(cp 补录:代码一直在读,这份样例此前漏了)
# =============================================================================
# 每个定时任务保留多少条运行记录(cz)。每小时跑一次的任务一年就是 8760 行,
# 而详情页只看最近几条,所以默认裁到 50。0 或负数 = 不裁剪,全部留着。
# PRISM_TASK_RUN_HISTORY=50
#
# 归档会话的自动清理天数(ct 加的功能,当时漏了写进这份样例)。
# 0 或不配 = 不自动清,归档留到手工删为止。
# PRISM_ARCHIVE_RETENTION_DAYS=0
#
# 每个用户的附件总量上限,单位 MB。超出后新上传直接 413,并给出已用/上限。
# PRISM_ATTACHMENT_QUOTA_MB=2048
#
# 附件留存天数。到期由清扫器按台账删文件并销账;0/不配 = 不自动清理。
# PRISM_ATTACHMENT_TTL_DAYS=30

# =============================================================================
# JupyterLab(notebook 标签页)
# =============================================================================
# Prism 惰性拉起一个共享的 jupyter lab,只绑回环,通过 /jupyter 反代进 iframe。
# PRISM_JUPYTER_DISABLED=1        # 整个 notebook 能力关掉(不装 jupyter 时建议配)
# PRISM_JUPYTER_BIN=jupyter       # 可执行名/绝对路径
# PRISM_JUPYTER_PORT=8888         # 不配则自动挑一个空闲端口

# =============================================================================
# 回合超时的三个细分闸门(默认值适配长任务,一般不用动)
# =============================================================================
# PRISM_TURN_IDLE_TIMEOUT_MS=       # 一个回合"完全没有新帧"多久算挂
# PRISM_TURN_TOOL_SILENCE_MAX_MS=   # 工具执行中允许的最长静默
#
# 自动压缩(维护回合)的预算 —— **和上面这套用户回合的预算是分开的**(db)。
# 用户回合里跑一小时的 SQL 正常,所以那边 idle 是一小时、绝对上限默认关闭;
# 压缩正常是几十秒的事,套同一套参数等于卡住了一小时没人管(线上出过)。
# idle 指的是"流上多久没动静",每来一条流消息就重置,不是压缩总耗时。
# PRISM_COMPACT_IDLE_TIMEOUT_MS=90000    # 默认 90s,盖住接近满窗时的首字延迟
# PRISM_COMPACT_TIMEOUT_MS=300000        # 默认 5min,超了就放弃、带未压缩上下文继续
#
# 上传与落盘
# PRISM_UPLOAD_MAX_TOTAL_MB=        # 单次上传总量上限
# PRISM_LAND_CHUNK_TTL_MS=          # 分片落盘的碎片过期时间
#
# 文件树/PDF/凭据的边角开关
# PRISM_FILETREE_ALLOW_EXTERNAL_READ=1   # 允许读工作区之外的路径(默认禁止)
# PRISM_PDF_MAX_PAGES=               # PDF 解析页数上限
# PRISM_CREDENTIAL_HEADERS=          # 额外允许透传的凭据头
# PRISM_DATA_DIR_EXPLICIT_GUARD=1    # 要求显式配置 DATA_DIR,防止误用默认目录
# PRISM_MA_API_MAX_BODY=             # 营销诊断反代的请求体上限
# PRISM_MA_API_TIMEOUT_MS=           # 营销诊断反代超时

# =============================================================================
# 反向代理(不是环境变量,但少配一件大文件上传就会 413 / 504)
# =============================================================================
#   client_max_body_size 512m;    # 与 /land 的 500MB 上限对齐;Files 面板要到 2048m
#   proxy_request_buffering off;  # 大文件不在网关落盘缓冲,直接流给上游
#   proxy_read_timeout 1800s;     # 与 Prism 的 30 分钟 requestTimeout 对齐
#   proxy_send_timeout 1800s;
# 完整模板见 docs/nginx-subpath-template.conf。

# =============================================================================
# 工作区边界与运行时(代码在读,此前一直没有文档)
# =============================================================================

# ★ 最要紧的一个 —— 所有文件访问的**唯一包含边界**。
#
# validateWorkspacePath、assertInsideWorkspaceRoot、Jupyter 的 --notebook-dir、
# 文件树的越界判定,全部以它为准。
#
# **不配 = 边界就是服务账号的整个家目录**,也就是说 ~/.ssh、~/.aws、~/.claude
# (里面有凭据)、~/.prism/auth.db 统统落在允许范围内。多用户部署务必收窄。
# WORKSPACES_ROOT=/srv/prism-workspaces

# 单次定时任务运行的硬超时(毫秒,默认 2 小时)。到点会真的中止那一轮
# (ez 之前只放开调度位、不中止,于是下一拍会起第二个进程写同一份 transcript)。
# PRISM_TASK_RUN_TIMEOUT_MS=7200000

# 一轮对话"静默多久判死"(毫秒,默认 1 小时)。常驻与一次性两条路径共用。
# 配 0 表示关掉看门狗 —— 只在排查问题时这么做。
# PRISM_TURN_IDLE_TIMEOUT_MS=3600000

# 每个会话最多留多少条显示日志(默认 2000,0 或负数表示不裁剪)。
# 这张表是全库行数最大的,不裁的话 2000 个会话约 1GB,再乘备份份数。
# PRISM_DISPLAY_LOG_MAX_PER_SESSION=2000

# 慢请求日志阈值(毫秒)。超过就打一行,便于定位卡顿。
# PRISM_SLOW_REQUEST_MS=3000

# 常驻 runtime 控制操作(预热/释放)的超时(毫秒)。
# PRISM_RUNTIME_CONTROL_TIMEOUT_MS=15000

# 工具审批等待多久算超时(毫秒)。默认不超时 —— 见 claude-sdk.js 顶部那段论证:
# 自动判"拒绝"会替一个根本没看见确认框的用户做决定。
# CLAUDE_TOOL_APPROVAL_TIMEOUT_MS=

# 文件系统并发度与 libuv 线程池大小。默认值适合大多数部署,只在大目录扫描明显
# 变慢时才调。
# FS_CONCURRENCY=8
# UV_THREADPOOL_SIZE=8

# =============================================================================
# 上游与 CLI 透传(ff 轮补文档 —— 代码一直在读,这里一直没写)
# =============================================================================
#
# 这一节的变量**不是 Prism 自己发明的**,是 Claude CLI / SDK 认的名字,Prism 只是
# 让它们从 .env 生效。写在这里是因为"代码在读、文档没有"本身就是运维事故的来源:
# 排查时看不到它存在,也就想不到它可能被谁设过。

# 自定义 Anthropic 网关地址。设了之后模型卡片上的价格/上下文长度可能对不上,
# 前端据此提示"仅供参考"。**只有 host 会暴露给前端**,完整 URL 不会 ——
# 路径里可能带租户 id 之类不该给所有登录用户看的东西。
# ANTHROPIC_BASE_URL=https://your-gateway.example.com

# 网关的鉴权 token。设了它就走 token 认证,不再要求每个用户自己登录 Claude。
# ⚠️ 这是**全服务共用的一把钥匙**:所有用户的请求都用它计费、用它鉴权。
# ANTHROPIC_AUTH_TOKEN=

# Claude CLI 的沙箱标记。和 IS_SANDBOX 一样,它的存在会让 CLI 允许 root 下的
# 「跳过权限」档位。**不要为了绕开那个提示而设它** —— 提示本身是对的。
# CLAUDE_CODE_BUBBLEWRAP=

# 流关闭超时(毫秒)。Prism 在构造 query 时会把它临时设成 300000 再恢复,
# 所以这里配了通常也会被覆盖;列出来是为了让人知道它存在。
# CLAUDE_CODE_STREAM_CLOSE_TIMEOUT=

# 平台模式(上游认证、不走 Prism 自己的登录)。构建期由 Vite 注入,
# 服务端也读同一个值。**普通部署不要设**。
# VITE_IS_PLATFORM=false

# --- 项目模板(fh 轮新增)------------------------------------------------
#
# 「新建项目」向导里的「从模板创建」。模板就是这个目录下的一棵普通目录树,
# 一个子目录 = 一个模板;创建项目时递归复制进去。
#
# **刻意没有模板引擎** —— 没有变量替换、没有条件渲染。目录 copy 覆盖 90% 需求,
# 剩下 10% 让人自己改两行,比维护一套模板语言便宜得多。
#
# 可选:模板目录里放一个 `.prism-template.json`(`{"name":"…","description":"…"}`)
# 给它起个好看的名字;不放就用目录名。这个文件本身不会被复制进项目。
#
# 四条硬规矩(见 project-template.service.ts 顶部):
#   1. 模板名只能是单段目录名,`..` / `/` 一律拒;
#   2. **模板里有符号链接 = 整个模板不可用**(跟随会把链接目标的内容复制进一个
#      别人看得见的项目;照抄链接会在项目里种一条指向外面的路);
#   3. 目标目录里已存在的同名文件**跳过不覆盖**(新建也可能是复活一条归档路径);
#   4. 单个模板最多 500 个文件 / 20MB。
#
# 不配 = 向导里那一格不显示,和升级前完全一样。
# 默认位置:~/.prism/templates
# PRISM_PROJECT_TEMPLATES_DIR=/home/jovyan/.prism/templates
