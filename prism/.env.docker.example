# Copy to `.env` next to docker-compose.yml, then fill in.
#   cp .env.docker.example .env
#
# docker-compose.yml loads this whole file into the container via `env_file`,
# so anything you uncomment here takes effect and anything you leave commented
# falls back to the code's own default. Three variables are pinned in the
# compose file instead, because each has to agree with something else in it,
# and setting them here does nothing:
#
#   SERVER_PORT=3001     must match the published port
#   HOST=0.0.0.0         must bind all interfaces or the published port is dead
#   WORKSPACES_ROOT=/workspace   must match the bind mount
#
# HOST=0.0.0.0 inside the container is not the exposure decision — the compose
# `ports:` mapping is. Restrict it there, with a firewall, or with a reverse
# proxy + TLS on untrusted networks.

# Claude (via the bundled Agent SDK) — the only provider.
ANTHROPIC_API_KEY=

# Signing secret for auth tokens — set a long random string and keep it stable
# (changing it invalidates existing logins). e.g. `openssl rand -hex 32`
JWT_SECRET=

# Optional shared-secret gate for ALL /api routes: requests must send a
# matching `x-prism-api-key` header when this is set. Leave empty to disable.
# The frontend pair (VITE_PRISM_API_KEY) is baked in at image BUILD time, so
# setting only the runtime variable will lock the bundled UI out — configure
# both at build time or leave unset and rely on the built-in login + JWT auth.
# PRISM_API_KEY=

# Key for the AES-256-GCM wrapper around stored third-party tokens (GitHub
# PATs, provider keys). 64 hex chars (`openssl rand -hex 32`) or a passphrase.
# Set this explicitly in Docker: without it a key is generated inside the
# container and stored in the database, so a restore onto a fresh volume — or
# a second replica — cannot decrypt those rows.
# PRISM_ENCRYPTION_KEY=

# Set to 1 — the compose file puts Prism behind its published port, and any
# real deployment fronts it with a reverse proxy. Without this the rate
# limiters see the proxy's IP for every client and share one bucket between
# them. Only set it when a proxy you control is actually in front.
# PRISM_TRUST_PROXY=1

# Allowed CORS origins, comma-separated. Unset stays permissive.
# PRISM_CORS_ORIGINS=

# ---- Rate limiting (defaults shown; raise rather than disable) ----
# PRISM_RATE_LIMIT=1              # 0 disables every limiter — dev only
# PRISM_RATE_LIMIT_WINDOW_MS=60000
# PRISM_RATE_LIMIT_MAX=600        # per IP per window, /api overall
# PRISM_AUTH_RATE_WINDOW_MS=900000
# PRISM_AUTH_RATE_MAX=50          # tighter budget for the auth routes
# PRISM_LOGIN_MAX_ATTEMPTS=5      # failures before per-account lockout
# PRISM_LOGIN_WINDOW_MS=900000
# PRISM_LOGIN_LOCKOUT_MS=900000   # doubles per repeat lockout, capped at 24 h

# ---- Data, database and backups ----
# You do not need PRISM_DATA_DIR to persist state: the image sets HOME=/data,
# so the default (~/.prism) already resolves to /data/.prism on the mounted
# volume, and auth.db, assets, checkpoints and plugins survive a container
# replacement as they are. Set it only to move that folder somewhere else —
# and if you do, point it inside /data or the data stops being persisted.
# PRISM_DATA_DIR=/data/.prism
# PRISM_DB_BACKUP=1               # 0 disables periodic SQLite snapshots
# PRISM_DB_BACKUP_INTERVAL_MS=86400000
# PRISM_DB_BACKUP_KEEP=7
# PRISM_AUDIT_LOG_MAX_ROWS=5000

# ---- File watching ----
# Bind mounts on Docker Desktop (macOS/Windows) often deliver no inotify
# events, so the session list stops updating. Set this to 1 there.
# PRISM_WATCH_POLL=0
# PRISM_WATCH_POLL_INTERVAL_MS=6000
# PRISM_FILETREE_MAX_ENTRIES=5000

# ---- Document ingestion limits ----
# PRISM_DOC_MAX_CHARS=200000
# PRISM_DOC_MAX_UNCOMPRESSED=209715200   # zip-bomb guard, in bytes
# PRISM_PDF_TIMEOUT_MS=30000
# PRISM_URL_FETCH_TIMEOUT_MS=20000

# ---- Browser use (optional) ----
# PRISM_BROWSER_USE_MAX_SESSIONS_PER_OWNER=3
# PRISM_BROWSER_USE_SESSION_TTL_MS=1800000
# PRISM_BROWSER_USE_INSTALL_TIMEOUT_MS=600000
# PRISM_BROWSER_USE_API_TIMEOUT_MS=60000
# PRISM_BROWSER_USE_API_URL / PRISM_BROWSER_USE_MCP_TOKEN are injected by the
# server into the MCP subprocess it spawns — setting them here does nothing.

# ---- Optional tuning (safe defaults if omitted) ----
# PRISM_PERSISTENT_SESSIONS=1     # set 0 to disable resident agent sessions
# PRISM_MAX_RUNTIMES=8            # max concurrent persistent agent sessions
# PRISM_RUNTIME_IDLE_MS=1800000   # idle session reclaim (default 30 min)
# PRISM_MAX_ONESHOT_OVERFLOW=2    # extra one-shot slots beyond the pool
# PRISM_TURN_TIMEOUT_MS=3600000   # per-turn watchdog (0 disables)
# PRISM_AUTO_COMPACT=1            # set 0 to disable auto /compact
# PRISM_AUTO_COMPACT_RATIO=0.8    # context high-water mark for auto /compact
# PRISM_CHECKPOINTS=1             # set 0 to disable per-turn git checkpoints
# PRISM_CHECKPOINT_DIR=           # default: ~/.prism/checkpoints (in /data)
# PRISM_CHECKPOINT_INCLUDE_IGNORED=0   # 1 also snapshots gitignored files
# PRISM_ALLOW_QUERY_TOKEN=0       # 1 accepts the legacy ?token= websocket JWT

# ---- Optional voice proxy (speech-to-text / text-to-speech) ----
# VOICE_API_BASE_URL=
# VOICE_API_KEY=
# VOICE_STT_MODEL=whisper-1
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy
# VOICE_TIMEOUT_MS=300000
